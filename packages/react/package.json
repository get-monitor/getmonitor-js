  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@rollup/plugin-typescript": "^11.1.6",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "jsdom": "^25.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "rollup": "^4.24.0",
    "tslib": "^2.6.0",
    "typescript": "^5.8.2",
    "vitest": "^2.1.0"
  }
