    "lint": "tsc --noEmit && tsc --noEmit -p e2e"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/node": "^20.14.0",
    "esbuild": "^0.24.0",
    "rollup": "^4.24.0",
    "tslib": "^2.6.0",
    "typescript": "^5.8.2",
    "vitest": "^2.1.0"
  }
}
