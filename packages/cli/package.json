{
  "name": "@getmonitor/cli",
  "version": "0.3.1",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "getmonitor": "dist/bin.js"
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rollup -c && chmod +x dist/bin.js",
